# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ============================================
# Database
# ============================================
# Leave DATABASE_URL unset in development to use the bundled PGlite server
# started with `npm run dev:db` (127.0.0.1:54329). Set it to point at a real
# PostgreSQL instance, and it is required in production.
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10

# Used by docker-compose to initialise a local PostgreSQL container
POSTGRES_USER=alumni_user
POSTGRES_PASSWORD=
POSTGRES_DB=alumni_network
POSTGRES_PORT=5432

# ============================================
# Authentication
# ============================================
# Both secrets must be set, must differ, and must be at least 32 characters
# in production. Development falls back to fixed, clearly-labelled secrets.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_random_string_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=alumni-network-portal

BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Rate limits (per IP)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_UPLOAD_MAX=20

# ============================================
# Token lifetimes
# ============================================
EMAIL_TOKEN_HOURS=48
PASSWORD_RESET_HOURS=2

# ============================================
# Development seed accounts (npm run seed)
# ============================================
# These are development-only. seed-dev-users.js refuses to run when
# NODE_ENV=production. Passwords are hashed at run time, so nothing is
# committed. Each variable is optional and falls back to the documented
# development default.
# SEED_ADMIN_EMAIL=admin@alumni.local
# SEED_ADMIN_PASSWORD=
# SEED_ALUMNI_EMAIL=alumni@alumni.local
# SEED_ALUMNI_PASSWORD=
# SEED_STUDENT_EMAIL=student@alumni.local
# SEED_STUDENT_PASSWORD=

# ============================================
# Uploads and storage
# ============================================
UPLOAD_MAX_BYTES=5242880
# local | s3
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./server/uploads

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_SIGNED_URL_SECONDS=900

# ============================================
# Email
# ============================================
# log writes to the email_queue table and console; smtp sends for real.
MAIL_DRIVER=log
MAIL_FROM_EMAIL=no-reply@alumni.example.edu
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ============================================
# OAuth (planned - provide locally only)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
OAUTH_STATE_SECRET=

# ============================================
# Payments (planned - provide locally only)
# ============================================
PAYMENT_PROVIDER=stripe
DONATION_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ============================================
# Maps (planned - provide locally only)
# ============================================
MAP_PROVIDER=none
MAP_API_KEY=
